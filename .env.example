# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=https://www.nextgen-en.com

# Database
DATABASE_URL=postgresql://esrc_user:esrc_password@localhost:5432/esrc_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-different-from-above
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# AWS S3 / Storage
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=esrc-cameroon-media

# Payments
MTN_MOMO_API_KEY=your-mtn-key
MTN_MOMO_API_SECRET=your-mtn-secret
MTN_MOMO_SUBSCRIPTION_KEY=your-subscription-key
MTN_MOMO_ENVIRONMENT=sandbox
ORANGE_MONEY_API_KEY=your-orange-key
ORANGE_MONEY_API_SECRET=your-orange-secret
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Email
SENDGRID_API_KEY=SG.your-sendgrid-key
EMAIL_FROM=noreply@esrc-cameroon.org
EMAIL_FROM_NAME=ESRC Cameroon

# SMS / Africa's Talking
AFRICAS_TALKING_API_KEY=your-at-key
AFRICAS_TALKING_USERNAME=your-username
AFRICAS_TALKING_SENDER_ID=ESRC

# AI - Hugging Face (FREE - Recommended)
# Get API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_api_token

# AI - OpenAI (OPTIONAL - Premium Alternative)
# Only required if you prefer OpenAI over Hugging Face
OPENAI_API_KEY=sk_your_openai_key

# Meilisearch (Full-Text Search)
# Default configuration for Docker: http://localhost:7700
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your-meilisearch-api-key

# WebSocket Configuration
WS_NAMESPACE=/ws
WS_TRANSPORTS=websocket,polling
